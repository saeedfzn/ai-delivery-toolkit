{
  "name": "lantern-delivery-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server over Jira-style tickets and Confluence-style pages for the fictional Project Lantern programme. Mock data by default, with an optional Jira and Confluence REST source.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "lantern-delivery-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "proof": "node scripts/jsonrpc-proof.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
